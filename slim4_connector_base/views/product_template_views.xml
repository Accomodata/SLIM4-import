<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="product_template_form_view_slim4" model="ir.ui.view">
    <field name="name">product.template.form.slim4</field>
    <field name="model">product.template</field>
    <field name="inherit_id" ref="product.product_template_form_view" />
    <field name="arch" type="xml">
      <xpath expr="//page[@name='purchase']//field[@name='seller_ids']" position="before">
        <group>
          <field name="slim4_matching_supplier_ids" invisible="1" groups="slim4_connector_base.primary_supplier_field" />
          <field name="slim4_primary_supplier_ids" widget="many2many_tags" invisible="not slim4_matching_supplier_ids" domain="[('id', 'in', slim4_matching_supplier_ids)]" options="{'no_create': True}" groups="slim4_connector_base.primary_supplier_field" />
        </group>
      </xpath>
      <xpath expr="//page[@name='inventory']" position="inside">
        <group string="Slim4" invisible="product_variant_count &gt; 1 and not is_product_variant">
          <field name="warehouse_ids" groups="slim4_connector_base.warehouse_field" widget="many2many_tags" />
          <field name="configure_stocked_item_warehouse_ids" readonly="0" groups="slim4_connector_base.warehouse_field,slim4_connector_base.stocked_item_field" >
            <list editable="bottom" no_open="1" create="0" delete="0">
              <field name="name" readonly="1"/>
              <field name="slim4_stocked_item" readonly="0"/>
            </list>
          </field>
        </group>
      </xpath>
    </field>
  </record>
</odoo>
