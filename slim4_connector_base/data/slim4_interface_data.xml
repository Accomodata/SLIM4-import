<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data noupdate="0">
    <record id="slim4_interface_article_filter" model="slim4.interface">
      <field name="name">Article Filter</field>
      <field name="technical_name">S4Import_ArticleFilter</field>
      <field name="source_model_id" ref="product.model_product_product" />
      <field name="source_domain"><![CDATA[[('default_code', '!=', False), ('active', '=', True), ('type', '=', 'consu')]]]></field>
    </record>
    <record id="slim4_interface_article_code_master" model="slim4.interface">
      <field name="name">Article Code Master</field>
      <field name="technical_name">S4Import_ArticleCodeMaster</field>
      <field name="source_model_id" ref="product.model_product_product" />
      <field name="source_domain"><![CDATA[[('default_code', '!=', False), ('active', '=', True), ('type', '=', 'consu')]]]></field>
    </record>
    <record id="slim4_interface_logistics" model="slim4.interface">
      <field name="name">Logistics</field>
      <field name="technical_name">S4Import_Logistics</field>
      <field name="source_model_id" ref="product.model_product_product" />
      <field name="source_domain"><![CDATA[[('default_code', '!=', False), ('active', '=', True), ('type', '=', 'consu'), ('slim4_primary_supplier_id', '!=', False)]]]></field>
    </record>
    <record id="slim4_interface_suppliers" model="slim4.interface">
      <field name="name">Suppliers</field>
      <field name="technical_name">S4Import_Suppliers</field>
      <field name="source_model_id" ref="product.model_product_supplierinfo" />
      <field name="source_domain"><![CDATA[[('product_tmpl_id.type', '=', 'consu'), ('product_tmpl_id.active', '=', True), '|', '&', ('product_id', '=', False), ('product_tmpl_id.product_variant_ids.default_code', '!=', False), '&', ('product_id.active', '=', True), ('product_id.default_code', '!=', False)]]]></field>
    </record>
    <record id="slim4_interface_purchase_order" model="slim4.interface">
      <field name="name">Purchase Order</field>
      <field name="technical_name">S4Import_PurchaseOrder</field>
      <field name="source_model_id" ref="purchase.model_purchase_order_line" />
      <field name="source_domain"><![CDATA[[('order_id.state', '=', 'purchase'), ('product_qty', '>', 0), ('product_id.default_code', '!=', False), ('move_ids.state', '!=', 'done'), ('product_id.type', '=', 'consu')]]]></field>
    </record>
    <record id="slim4_interface_stock_details" model="slim4.interface">
      <field name="name">Stock Details</field>
      <field name="technical_name">S4Import_StockDetails</field>
      <field name="source_model_id" ref="stock.model_stock_quant" />
      <field name="source_domain"><![CDATA[[('location_id.usage', '=', 'internal'), ('quantity', '!=', 0), ('product_id.default_code', '!=', False), ('product_id.type', '=', 'consu')]]]></field>
    </record>
    <record id="slim4_interface_transactions" model="slim4.interface">
      <field name="name">Transactions</field>
      <field name="technical_name">S4Import_Transactions</field>
      <field name="source_model_id" ref="stock.model_stock_move" />
      <field name="source_domain"><![CDATA[[('state', '=', 'done'), ('product_id.default_code', '!=', False), ('warehouse_id.code', '!=', False), ('picking_type_id.code', '=', 'outgoing'), ('product_id.type', '=', 'consu')]]]></field>
    </record>
    <record id="slim4_interface_confirmed_demand" model="slim4.interface">
      <field name="name">Confirmed Demand</field>
      <field name="technical_name">S4Import_ConfirmedDemand</field>
      <field name="source_model_id" ref="sale.model_sale_order_line" />
      <field name="source_domain"><![CDATA[[('order_id.state', 'in', ['sale', 'done']), ('product_uom_qty', '>', 0), ('product_id.default_code', '!=', False), ('move_ids.state', '!=', 'done'), ('product_id.type', '=', 'consu')]]]></field>
    </record>
    <!-- Out-of-scope interfaces are prepared but disabled by default. -->
    <record id="slim4_interface_bill_of_material" model="slim4.interface">
      <field name="name">Bill of Material</field>
      <field name="technical_name">S4Import_BillOfMaterial</field>
      <field name="source_model_id" ref="mrp.model_mrp_bom_line" />
      <field name="source_domain"><![CDATA[[('bom_id.active', '=', True), ('bom_id.product_tmpl_id.active', '=', True), ('bom_id.product_tmpl_id.default_code', '!=', False), ('product_id.active', '=', True), ('product_id.default_code', '!=', False), ('product_id.type', '=', 'consu')]]]></field>
      <field name="active" eval="False" />
    </record>
    <record id="slim4_interface_variant_generic" model="slim4.interface">
      <field name="name">Variant Generic</field>
      <field name="technical_name">S4Import_VariantGeneric</field>
      <field name="source_model_id" ref="product.model_product_product" />
      <field name="source_domain"><![CDATA[[('active', '=', True), ('default_code', '!=', False), ('product_template_attribute_value_ids', '!=', False), ('type', '=', 'consu')]]]></field>
      <field name="active" eval="False" />
    </record>
    <record id="slim4_interface_historical_po" model="slim4.interface">
      <field name="name">Historical PO</field>
      <field name="technical_name">S4Import_Historical_PO</field>
      <field name="source_model_id" ref="purchase.model_purchase_order_line" />
      <field name="source_domain"><![CDATA[[('order_id.state', '=', 'purchase'), ('product_id.default_code', '!=', False), ('qty_received', '>', 0), ('product_id.type', '=', 'consu')]]]></field>
      <field name="active" eval="False" />
    </record>
  </data>
</odoo>
