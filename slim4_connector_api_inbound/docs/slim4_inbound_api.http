@baseUrl = https://ODOO_HOST
@apiKey = ODOO_19_API_KEY
@invalidApiKey = INVALID_API_KEY
@supplierNumber = ODOO_SUPPLIER_ID
@articleCode = ODOO_PRODUCT_ID_OR_DEFAULT_CODE

### Valid order batch
# Expected: 200 OK
# {"status":"success","message":"Orders received successfully"}
POST {{baseUrl}}/slim4/api/v1/orders
Authorization: Bearer {{apiKey}}
Content-Type: application/json

{
  "order": [
    {
      "supplierNumber": "{{supplierNumber}}",
      "articleCode": "{{articleCode}}",
      "toOrder": 10,
      "salesOrder": "SLIM4-SO-001",
      "lineNumber": "1"
    }
  ]
}

### Missing authentication
# Expected: 401 Unauthorized, generated by Odoo bearer authentication.
POST {{baseUrl}}/slim4/api/v1/orders
Content-Type: application/json

{
  "order": [
    {
      "supplierNumber": "{{supplierNumber}}",
      "articleCode": "{{articleCode}}",
      "toOrder": 10
    }
  ]
}

### Invalid authentication
# Expected: 401 Unauthorized, generated by Odoo bearer authentication.
POST {{baseUrl}}/slim4/api/v1/orders
Authorization: Bearer {{invalidApiKey}}
Content-Type: application/json

{
  "order": [
    {
      "supplierNumber": "{{supplierNumber}}",
      "articleCode": "{{articleCode}}",
      "toOrder": 10
    }
  ]
}

### Invalid JSON
# Expected: 400 Bad Request
# {"error":{"code":"invalid_json","message":"The request body must contain valid JSON."}}
POST {{baseUrl}}/slim4/api/v1/orders
Authorization: Bearer {{apiKey}}
Content-Type: application/json

{
  "order": [
    {
      "supplierNumber": "{{supplierNumber}}",
      "articleCode": "{{articleCode}}",
      "toOrder": 10,
    }
  ]
}

### Incomplete order
# Expected: 422 Unprocessable Entity
# Error code: invalid_payload
# Message: Missing required order fields: supplierNumber, articleCode/code.
# Context item_index: 0
# Context missing_fields: supplierNumber, articleCode/code
POST {{baseUrl}}/slim4/api/v1/orders
Authorization: Bearer {{apiKey}}
Content-Type: application/json

{
  "order": [
    {
      "toOrder": 10
    }
  ]
}

### Invalid quantity
# Expected: 422 Unprocessable Entity
# Error code: invalid_payload
# Message: The "toOrder" value must be strictly positive.
# Context: {"item_index":0}
POST {{baseUrl}}/slim4/api/v1/orders
Authorization: Bearer {{apiKey}}
Content-Type: application/json

{
  "order": [
    {
      "supplierNumber": "{{supplierNumber}}",
      "articleCode": "{{articleCode}}",
      "toOrder": 0
    }
  ]
}

### Invalid order collection type
# Expected: 422 Unprocessable Entity
# Error code: invalid_payload
# Message: The "order" property must be a list.
POST {{baseUrl}}/slim4/api/v1/orders
Authorization: Bearer {{apiKey}}
Content-Type: application/json

{
  "order": "not-a-list"
}

### Unknown operation
POST {{baseUrl}}/slim4/api/v1/unknown-operation
Authorization: Bearer {{apiKey}}
Content-Type: application/json

{
  "order": []
}
