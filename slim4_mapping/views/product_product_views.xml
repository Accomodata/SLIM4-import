<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="product_product_view_form" model="ir.ui.view">
    <field name="name">product.product.view.form.inherit.slim4</field>
    <field name="model">product.product</field>
    <field name="inherit_id" ref="stock.product_form_view_procurement_button" />
    <field name="arch" type="xml">
      <xpath expr="//page[@name='inventory']" position="inside">
        <group string="Slim4">
          <field name="warehouse_ids"
            groups="slim4_mapping.group_slim4_warehouse_field"
            widget="many2many_tags" />
        </group>
      </xpath>
    </field>
  </record>
</odoo>
