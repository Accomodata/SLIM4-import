<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- ACTIONS -->
  <record id="action_slim4_interface_mapping" model="ir.actions.act_window">
    <field name="name">Field Mappings</field>
    <field name="res_model">slim4.interface.mapping</field>
    <field name="view_mode">list,form</field>
  </record>
  <!-- LISTS -->
  <record id="slim4_interface_mapping_view_list" model="ir.ui.view">
    <field name="name">slim4.interface.mapping.view.list</field>
    <field name="model">slim4.interface.mapping</field>
    <field name="arch" type="xml">
      <list string="Slim4 Field Mappings" decoration-success="status == 'validated'" decoration-warning="status == 'to_validate'" decoration-muted="status == 'ignored' " decoration-danger="status == 'mapping_error'">
        <field name="sequence"/>
        <field name="slim4_field"/>
        <field name="mapping_type" optional="show"/>
        <field name="field_path" optional="show" widget="field_selector" invisible="mapping_type not in ['field', 'rule']" options="{'model': 'source_model', 'follow_relations': true, 'allow_properties': false}" />
        <field name="split_records" optional="hide" groups="base.group_no_one"/>
        <field name="slim4_required" optional="show"/>
        <field name="field_type" optional="hide"/>
        <field name="status" optional="hide"/>
      </list>
    </field>
  </record>
  <!-- FORMS -->
  <record id="slim4_interface_mapping_view_form" model="ir.ui.view">
    <field name="name">slim4.interface.mapping.view.form</field>
    <field name="model">slim4.interface.mapping</field>
    <field name="arch" type="xml">
      <form string="Slim4 Field Mapping">
        <sheet>
          <group>
            <group colspan="2">
              <div class="oe_title">
                <h1>
                  <field name="name"/>
                </h1>
              </div>
            </group>
            <group>
              <field name="sequence"/>
              <field name="interface_id"/>
              <field name="slim4_field"/>
              <field name="slim4_required"/>
            </group>
            <group>
              <field name="mapping_type"/>
              <field name="field_type"/>
              <field name="field_path" invisible="mapping_type not in ['field', 'rule']" groups="base.group_no_one"/>
              <field name="constant_value" invisible="mapping_type != 'constant'" />
              <field name="split_records" groups="base.group_no_one"/>
              <field name="status"/>
            </group>
          </group>
          <notebook>
            <page name="Notes" string="Notes">
              <field name="notes" />
            </page>
            <page name="Errors" string="Errors" decoration-danger="mapping_error" invisible="not mapping_error">
              <field name="mapping_error" decoration-danger="mapping_error"/>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>
  <!-- SEARCH -->
  <record id="slim4_interface_mapping_view_search" model="ir.ui.view">
    <field name="name">slim4.interface.mapping.view.search</field>
    <field name="model">slim4.interface.mapping</field>
    <field name="arch" type="xml">
      <search string="Slim4 Field Mappings">
        <field name="slim4_field"/>
        <field name="interface_id"/>
        <filter name="validated" string="validated" domain="[('status', '=', 'validated')]"/>
        <filter name="to_validate" string="To Validate" domain="[('status', '=', 'to_validate')]"/>
        <filter name="ignored" string="Ignored" domain="[('status', '=', 'ignored')]"/>
        <separator/>
        <filter name="mapping_type_field" string="Field Mapping" domain="[('mapping_type', '=', 'field')]"/>
        <filter name="mapping_type_rule" string="Rule Mapping" domain="[('mapping_type', '=', 'rule')]"/>
        <separator/>
        <group>
          <filter name="group_interface" string="Interface" context="{'group_by': 'interface_id'}"/>
          <filter name="group_status" string="Status" context="{'group_by': 'status'}"/>
          <filter name="group_mapping_type" string="Mapping Type" context="{'group_by': 'mapping_type'}"/>
        </group>
      </search>
    </field>
  </record>
</odoo>
