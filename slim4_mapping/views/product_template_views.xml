<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="product_template_form_view_slim4" model="ir.ui.view">
    <field name="name">product.template.form.slim4</field>
    <field name="model">product.template</field>
    <field name="inherit_id" ref="product.product_template_form_view" />
    <field name="arch" type="xml">

      <xpath expr="//page[@name='purchase']//field[@name='seller_ids']" position="before">
        <group>
          <field name="slim4_primary_supplier_ids" widget="many2many_tags" />
        </group>
      </xpath>

      <xpath expr="//page[@name='sales']" position="inside">
        <field name="slim4_show_moq" invisible="1" />
        <field name="slim4_show_ioq" invisible="1" />

        <group string="Slim4" invisible="product_variant_count != 1">
          <field name="slim4_moq" invisible="not slim4_show_moq" />
          <field name="slim4_ioq" invisible="not slim4_show_ioq" />
        </group>
      </xpath>

    </field>
  </record>

</odoo>
