<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data noupdate="0">
    <record id="slim4_interface_article_filter" model="slim4.interface">
      <field name="name">Article Filter</field>
      <field name="technical_name">S4Import_ArticleFilter</field>
      <field name="source_model_id" ref="product.model_product_product"/>
      <field name="source_domain"><![CDATA[[('default_code', '!=', False), ('active', '=', True)]]]></field>
    </record>
    <record id="slim4_interface_article_code_master" model="slim4.interface">
      <field name="name">Article Code Master</field>
      <field name="technical_name">S4Import_ArticleCodeMaster</field>
      <field name="source_model_id" ref="product.model_product_product"/>
      <field name="source_domain"><![CDATA[[('default_code', '!=', False), ('active', '=', True)]]]></field>
    </record>
    <record id="slim4_interface_logistics" model="slim4.interface">
      <field name="name">Logistics</field>
      <field name="technical_name">S4Import_Logistics</field>
      <field name="source_model_id" ref="product.model_product_supplierinfo"/>
      <field name="source_domain"><![CDATA[[('product_tmpl_id.active', '=', True)]]]></field>
      <field name="active">False</field>
    </record>
    <record id="slim4_interface_purchase_order" model="slim4.interface">
      <field name="name">Purchase Order</field>
      <field name="technical_name">S4Import_PurchaseOrder</field>
      <field name="source_model_id" ref="purchase.model_purchase_order_line"/>
      <field name="source_domain"><![CDATA[[('order_id.state', '=', 'purchase'), ('product_qty', '>', 0), ('product_id.default_code', '!=', False)]]]></field>
    </record>
    <record id="slim4_interface_stock_details" model="slim4.interface">
      <field name="name">Stock Details</field>
      <field name="technical_name">S4Import_StockDetails</field>
      <field name="source_model_id" ref="stock.model_stock_quant"/>
      <field name="source_domain"><![CDATA[[('quantity', '!=', 0), ('product_id.default_code', '!=', False)]]]></field>
      <field name="active">False</field>
    </record>
    <record id="slim4_interface_transactions" model="slim4.interface">
      <field name="name">Transactions</field>
      <field name="technical_name">S4Import_Transactions</field>
      <field name="source_model_id" ref="stock.model_stock_move"/>
      <field name="source_domain"><![CDATA[[('state', '=', 'done'), ('product_id.default_code', '!=', False)]]]></field>
      <field name="active">False</field>
    </record>
    <record id="slim4_interface_confirmed_demand" model="slim4.interface">
      <field name="name">Confirmed Demand</field>
      <field name="technical_name">S4Import_ConfirmedDemand</field>
      <field name="source_model_id" ref="sale.model_sale_order_line"/>
      <field name="source_domain"><![CDATA[[('order_id.state', 'in', ['sale', 'done']), ('product_uom_qty', '>', 0), ('product_id.default_code', '!=', False)]]]></field>
    </record>
  </data>
</odoo>
