<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="slim4_specific_rule_wizard_view_form" model="ir.ui.view">
    <field name="name">slim4.specific.rule.wizard.form</field>
    <field name="model">slim4.specific.rule.wizard</field>
    <field name="arch" type="xml">
        <form string="Python Rule">
            <group>
                <field name="mapping_id"/>
            </group>

            <field
                name="code"
                placeholder="result = record.product_qty - record.qty_received"
            />

            <footer>
                <button
                    name="action_save"
                    type="object"
                    string="Save"
                    class="btn-primary"
                />
                <button
                    string="Cancel"
                    special="cancel"
                    class="btn-secondary"
                />
            </footer>
        </form>
    </field>
</record>
</odoo>
