<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="warehouse_field" model="res.groups">
    <field name="name">Slim4: Display Warehouse Field</field>
    <field name="comment">Controls access and visibility for Slim4 Warehouse fields.</field>
  </record>

  <record id="primary_supplier_field" model="res.groups">
    <field name="name">Slim4: Display Primary Supplier Field</field>
    <field name="comment">Controls access and visibility for Slim4 Primary Supplier Field fields.</field>
  </record>

  <record id="ioq_field" model="res.groups">
    <field name="name">Slim4: Display IOQ Field</field>
    <field name="comment">Controls access and visibility for Slim4 Incremental Order Quantity fields.</field>
  </record>

  <record id="base.group_user" model="res.groups">
    <field name="implied_ids" eval="[(4, ref('slim4_mapping.warehouse_field'))]" />
    <field name="implied_ids" eval="[(4, ref('slim4_mapping.primary_supplier_field'))]" />
    <field name="implied_ids" eval="[(4, ref('slim4_mapping.ioq_field'))]" />
  </record>
</odoo>
